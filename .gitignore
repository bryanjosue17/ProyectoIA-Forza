# Carpetas locales (cada submódulo tiene su propio repo)
# Las carpetas de los submódulos se gestionan como submódulos Git y no deben
# ser ignoradas aquí para permitir su seguimiento. Si quieres excluirlas,
# maneja los backups localmente en vez de usar .gitignore.

# Node modules y deps locales
node_modules/
bin/
obj/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Env
.env
.env.local

# Documentos temporales
*.docx
